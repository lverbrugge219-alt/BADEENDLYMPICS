{
  "entities": {
    "Team": {
      "title": "Team",
      "description": "Represents a participating team in the Badeendlympics 2027.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the team."
        },
        "name": {
          "type": "string",
          "description": "Official team name in uppercase.",
          "maxLength": 100
        },
        "aanvoerder": {
          "type": "string",
          "description": "Full name of the team captain.",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Contact email address of the team captain.",
          "maxLength": 150
        },
        "password": {
          "type": "string",
          "description": "Team portal management password.",
          "maxLength": 100
        },
        "members": {
          "type": "array",
          "description": "List of the 4 team members."
        },
        "registeredAt": {
          "type": "string",
          "description": "ISO timestamp when the team registered."
        },
        "scores": {
          "type": "object",
          "description": "Mapping of spelId to points scored."
        },
        "totaal": {
          "type": "number",
          "description": "Calculated total points across all 5 disciplines."
        },
        "avatarType": {
          "type": "string",
          "description": "Avatar type: 'preset' or 'custom'."
        },
        "avatarPresetId": {
          "type": "string",
          "description": "Preset duck avatar ID."
        },
        "photoUrl": {
          "type": "string",
          "description": "Compressed Base64 photo data URL."
        }
      },
      "required": ["id", "name", "aanvoerder", "email", "members", "registeredAt"]
    },
    "ScoreEntry": {
      "title": "ScoreEntry",
      "description": "Represents points awarded to a team for a specific discipline.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique score identifier."
        },
        "teamId": {
          "type": "string",
          "description": "Optional team document ID."
        },
        "teamName": {
          "type": "string",
          "description": "Name of the team the score belongs to.",
          "maxLength": 100
        },
        "spelId": {
          "type": "string",
          "description": "Identifier of the discipline (e.g. geheim-01).",
          "maxLength": 50
        },
        "spelName": {
          "type": "string",
          "description": "Display name of the discipline.",
          "maxLength": 100
        },
        "points": {
          "type": "number",
          "description": "Numerical points awarded."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last score update."
        }
      },
      "required": ["id", "teamName", "spelId", "spelName", "points", "updatedAt"]
    },
    "JuryMember": {
      "title": "JuryMember",
      "description": "Represents a volunteer jury member who judges the Badeendlympics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique jury member identifier."
        },
        "name": {
          "type": "string",
          "description": "Full name of the jury member.",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Contact email address of the jury member.",
          "maxLength": 150
        },
        "password": {
          "type": "string",
          "description": "SHA-256 hashed password for jury self-service profile editing."
        },
        "isHeadJury": {
          "type": "boolean",
          "description": "Flag set by organization if member is Head of Jury."
        },
        "isOrganizer": {
          "type": "boolean",
          "description": "Flag set by organization if member is an organizer."
        },
        "bioQuote": {
          "type": "string",
          "description": "Personal quote or motto as jury member.",
          "maxLength": 500
        },
        "scoutingAffiliation": {
          "type": "string",
          "description": "Affiliation with scouting or organization.",
          "maxLength": 150
        },
        "avatarType": {
          "type": "string",
          "enum": ["preset", "custom"]
        },
        "avatarPresetId": {
          "type": "string"
        },
        "photoUrl": {
          "type": "string",
          "description": "Compressed Base64 avatar data URL (WebP/JPEG)."
        },
        "status": {
          "type": "string",
          "enum": ["active", "pending"]
        },
        "registeredAt": {
          "type": "string",
          "description": "ISO timestamp of registration."
        },
        "favoriteSpel": {
          "type": "string"
        }
      },
      "required": ["id", "name", "email", "registeredAt"]
    },
    "FaqItem": {
      "title": "FaqItem",
      "description": "Represents a frequently asked question and answer managed by the organization.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the FAQ item."
        },
        "question": {
          "type": "string",
          "description": "The question title or text.",
          "maxLength": 300
        },
        "answer": {
          "type": "string",
          "description": "The detailed answer to the question.",
          "maxLength": 2000
        },
        "order": {
          "type": "number",
          "description": "Display order index."
        },
        "category": {
          "type": "string",
          "description": "Optional category (e.g. Algemeen, Teams, Spellen, Jury).",
          "maxLength": 50
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update."
        }
      },
      "required": ["id", "question", "answer"]
    },
    "MinigameScore": {
      "title": "MinigameScore",
      "description": "Highscore record for the competitive Badeendjes Meppen teaser minigame.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the minigame score record."
        },
        "playerName": {
          "type": "string",
          "description": "Nickname or name of the player.",
          "maxLength": 50
        },
        "teamName": {
          "type": "string",
          "description": "Optional team name the player represents.",
          "maxLength": 100
        },
        "score": {
          "type": "number",
          "description": "Total final points achieved in the minigame."
        },
        "accuracy": {
          "type": "number",
          "description": "Accuracy percentage of successful hits."
        },
        "maxStreak": {
          "type": "number",
          "description": "Maximum hit streak / combo multiplier attained."
        },
        "avgReactionTimeMs": {
          "type": "number",
          "description": "Average reaction time in milliseconds."
        },
        "rankTitle": {
          "type": "string",
          "description": "Earned Badeendlympics rank title.",
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the score was recorded."
        }
      },
      "required": ["id", "playerName", "score", "createdAt"]
    }
  },
  "firestore": {
    "/teams/{teamId}": {
      "schema": {
        "$ref": "#/entities/Team"
      },
      "description": "Collection of all registered teams."
    },
    "/scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/ScoreEntry"
      },
      "description": "Collection of recorded scores for each game and team."
    },
    "/jury_members/{juryId}": {
      "schema": {
        "$ref": "#/entities/JuryMember"
      },
      "description": "Collection of volunteer jury members."
    },
    "/faqs/{faqId}": {
      "schema": {
        "$ref": "#/entities/FaqItem"
      },
      "description": "Collection of frequently asked questions managed by the organization."
    },
    "/minigame_scores/{scoreId}": {
      "schema": {
        "$ref": "#/entities/MinigameScore"
      },
      "description": "Collection of public competitive leaderboard scores for Badeendjes Meppen."
    }
  }
}
